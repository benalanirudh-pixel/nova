{"nodes": [{"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "label": "shadcn/ui Accessibility Patterns", "rationale": "ARIA patterns, keyboard navigation, screen reader support, and accessible component usage", "file_type": "document", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_radix_ui_primitives", "label": "Radix UI Primitives", "rationale": "Foundation: unstyled, accessible components following WAI-ARIA design patterns; built-in keyboard navigation, screen reader announcements, focus management, ARIA attributes automatically applied", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_keyboard_navigation", "label": "Keyboard Navigation", "rationale": "Focus visible states, skip to content, dialog focus trap (Esc closes, Tab cycles, focus returns to trigger), dropdown arrow navigation, command palette type-to-filter", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_screen_reader_support", "label": "Screen Reader Support", "rationale": "Semantic HTML, ARIA labels, sr-only screen reader text, live regions (polite/assertive), toast live region announced automatically", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_form_accessibility", "label": "Form Accessibility", "rationale": "Labels and descriptions, error handling with aria-invalid/aria-describedby, required fields, fieldset and legend grouping", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_wcag_color_contrast", "label": "WCAG Color Contrast", "rationale": "AA: 4.5:1 normal text, 3:1 large text; AAA: 7:1 normal, 4.5:1 large; use semantic muted foreground", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_focus_indicators", "label": "Focus Indicators", "rationale": "Visible focus rings with focus-visible, custom focus styles, never remove focus styles with focus:outline-none", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_reduced_motion", "label": "Reduced Motion", "rationale": "Respect prefers-reduced-motion: reduce via CSS animation/transition overrides and motion-reduce:transition-none classes", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"id": "claude_skills_ui_styling_references_shadcn_accessibility_md_accessibility_testing", "label": "Accessibility Testing", "rationale": "Checklist: keyboard accessible, focus visible, screen reader announcements, WCAG AA contrast, semantic HTML, ARIA labels, dialog focus trap, dropdown keyboard, live regions, reduced motion, 200% zoom, logical tab order, skip links; tools: Lighthouse, axe DevTools, NVDA/JAWS", "file_type": "concept", "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}], "edges": [{"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_radix_ui_primitives", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_keyboard_navigation", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_screen_reader_support", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_form_accessibility", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_wcag_color_contrast", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_focus_indicators", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_reduced_motion", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/references/shadcn-accessibility.md"}, {"source": "claude_skills_ui_styling_references_shadcn_accessibility_md_accessibility_testing", "target": "claude_skills_ui_styling_references_shadcn_accessibility_md_shadcn_accessibility", "relation": "part_of", "confidence_score": 1.0, "source_file": ".claude/skills/ui-styling/