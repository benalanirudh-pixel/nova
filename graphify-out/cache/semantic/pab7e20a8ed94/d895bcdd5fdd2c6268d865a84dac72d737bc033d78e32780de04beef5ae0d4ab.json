{"nodes": [{"id": "claude_skills_design_system_skill_design_system", "label": "Design System Skill", "file_type": "document", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Token architecture, component specifications, systematic design, and slide generation skill used by ui-ux-designer and frontend-developer agents."}, {"id": "claude_skills_design_system_skill_three_layer_token_architecture", "label": "Three-Layer Token Architecture", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Primitive (raw values) \u2192 Semantic (purpose aliases) \u2192 Component (component-specific) layers enable theme switching via the semantic layer and per-component customization via component tokens; raw hex values are prohibited in components."}, {"id": "claude_skills_design_system_skill_primitive_tokens", "label": "Primitive Tokens", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Raw token values, e.g. --color-blue-600: #2563EB; base layer of the three-layer token architecture."}, {"id": "claude_skills_design_system_skill_semantic_tokens", "label": "Semantic Tokens", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Purpose aliases that reference primitives, e.g. --color-primary: var(--color-blue-600); enables light/dark theme switching."}, {"id": "claude_skills_design_system_skill_component_tokens", "label": "Component Tokens", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Component-specific token values, e.g. --button-bg: var(--color-primary); enables per-component customization."}, {"id": "claude_skills_design_system_skill_css_variable_system", "label": "CSS Variable System", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Design tokens exposed as CSS variables (var(--color-primary), var(--slide-bg), var(--typography-font-heading)); single source of truth imported by slides."}, {"id": "claude_skills_design_system_skill_component_spec_pattern", "label": "Component Spec Pattern", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Component property spec across Background, Text, Border, Shadow for Default, Hover, Active, Disabled states."}, {"id": "claude_skills_design_system_skill_slide_system", "label": "Slide System", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Brand-compliant presentations using design tokens, Chart.js, and a contextual decision system; all slides must import design-tokens.css and use var() exclusively."}, {"id": "claude_skills_design_system_skill_chart_js_integration", "label": "Chart.js Integration", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Charts must use Chart.js (not CSS-only bars); slide HTML loads chart.js@4.4.1 from jsDelivr and renders canvas datasets with token-branded colors."}, {"id": "claude_skills_design_system_skill_bm25_slide_search", "label": "BM25 Slide Search", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "search-slides.py performs BM25 search with auto domain detection, domain-specific search (-d copy/chart), and contextual search (--context, --position, --prev-emotion)."}, {"id": "claude_skills_design_system_skill_contextual_decision_flow", "label": "Contextual Decision Flow", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Parse goal/context \u2192 search slide-strategies.csv \u2192 per-slide queries of slide-layout-logic, slide-typography, slide-color-logic, slide-backgrounds CSVs \u2192 apply animation class \u2192 generate HTML with tokens \u2192 validate with slide-token-validator.py."}, {"id": "claude_skills_design_system_skill_duarte_sparkline", "label": "Duarte Sparkline Pattern Breaking", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Premium decks alternate between emotions for engagement (What Is frustration \u2194 What Could Be hope); system calculates pattern breaks at 1/3 and 2/3 slide positions."}, {"id": "claude_skills_design_system_skill_token_compliance", "label": "Token Compliance", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Slides must import design-tokens.css, use CSS variables only, Chart.js for charts, include keyboard/click/progress navigation, center-align content, and focus on persuasion/conversion; validated by slide-token-validator.py."}, {"id": "claude_skills_design_system_skill_tailwind_integration", "label": "Tailwind Integration", "file_type": "rationale", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Component tokens flow into Tailwind theme configuration as part of the ui-styling integration path."}, {"id": "claude_skills_design_system_skill_brand_skill", "label": "Brand Skill", "file_type": "document", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Declared skill dependency of the design-system skill; brand colors/typography are extracted as design-system primitives."}, {"id": "claude_skills_design_system_skill_ui_styling_skill", "label": "UI Styling Skill", "file_type": "document", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Declared skill dependency of the design-system skill; component tokens feed into Tailwind config via this skill."}, {"id": "claude_skills_design_system_skill_ui_ux_designer_agent", "label": "UI/UX Designer Agent", "file_type": "document", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Primary agent for the design-system skill."}, {"id": "claude_skills_design_system_skill_frontend_developer_agent", "label": "Frontend Developer Agent", "file_type": "document", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Primary agent for the design-system skill."}, {"id": "claude_skills_design_system_skill_generate_tokens_script", "label": "generate-tokens.cjs", "file_type": "code", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Generates CSS from JSON token config (node scripts/generate-tokens.cjs --config tokens.json -o tokens.css)."}, {"id": "claude_skills_design_system_skill_validate_tokens_script", "label": "validate-tokens.cjs", "file_type": "code", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Checks for hardcoded values in code (node scripts/validate-tokens.cjs --dir src/)."}, {"id": "claude_skills_design_system_skill_search_slides_script", "label": "search-slides.py", "file_type": "code", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "BM25 search plus contextual recommendations for slide content."}, {"id": "claude_skills_design_system_skill_slide_token_validator_script", "label": "slide-token-validator.py", "file_type": "code", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Validates slide HTML for design-token compliance."}, {"id": "claude_skills_design_system_skill_fetch_background_script", "label": "fetch-background.py", "file_type": "code", "source_file": ".claude/skills/design-system/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": "claudekit", "contributor": null, "rationale": "Fetches images from Pexels/Unsplash for slide backgrounds."}, {"id": "claude_skills_design_system_skill_design_tokens_starter", "labe